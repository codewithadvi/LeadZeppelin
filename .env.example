# Required: get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback LLM if Groq fails/rate-limits: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional bonus feature: LinkedIn search fallback, free tier at https://tavily.com
TAVILY_API_KEY=

# Crawler tuning (optional, sane defaults if omitted)
MAX_SUBPAGES=5
PAGE_TIMEOUT_MS=15000
MAX_CHARS_PER_PAGE=4000
